CATALOG_PATH=catalog/catalog.yaml
DATA_DIR=data

# Embeddings for search_catalog. EMBEDDINGS_PROVIDER selects the wire
# format: "ollama" (default) talks to a local Ollama instance; "gemini"
# talks to the Gemini API (needs EMBEDDINGS_API_KEY, no local server).
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_API_URL=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text

# To use Gemini instead:
# EMBEDDINGS_PROVIDER=gemini
# EMBEDDINGS_MODEL=gemini-embedding-001
# EMBEDDINGS_API_KEY=<your Gemini API key>
# (EMBEDDINGS_API_URL is unused for the gemini provider)

# Chat model for cmd/host: any OpenAI-compatible chat-completions API.
# Ollama exposes one built in at /v1 (no key needed). Point LLM_API_URL at
# OpenAI itself, vLLM, llama.cpp server, OpenCode Go, etc. instead and set
# LLM_API_KEY if it requires one.
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=

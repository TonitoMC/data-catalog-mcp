CATALOG_PATH=catalog/catalog.yaml
DATA_DIR=data

# Local Ollama instance (default port). No API key needed.
EMBEDDINGS_API_URL=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text

# Chat model for cmd/chat: any OpenAI-compatible chat-completions API.
# Ollama exposes one built in at /v1 (no key needed). Point LLM_API_URL at
# OpenAI itself, vLLM, llama.cpp server, etc. instead and set LLM_API_KEY
# if it requires one.
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
